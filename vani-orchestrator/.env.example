# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── LiveKit ───────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_AGENT_NAME=vani-agent

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Twilio ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# ── Public URL (used for Twilio callbacks) ────────────────────
ORCHESTRATOR_PUBLIC_URL=https://your-orchestrator.railway.app

# ── OpenAI (for post-processing analysis + embeddings) ────────
OPENAI_API_KEY=sk-...

# ── Workers ───────────────────────────────────────────────────
WORKER_COUNT=2
POST_PROCESSOR_COUNT=1
OUTBOUND_WORKER_COUNT=1

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8001
