{
  "routes": [
    { "src": "/education", "dest": "/education.html" },
    { "src": "/pricing", "dest": "/pricing.html" },
    { "src": "/use-cases", "dest": "/use-cases.html" },
    { "src": "/integrations", "dest": "/integrations.html" },
    { "src": "/enterprise", "dest": "/enterprise.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/education.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
