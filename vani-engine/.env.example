# ── LiveKit ───────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ── Supabase (for KB + long-term memory) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Orchestrator ──────────────────────────────────────────────
ORCHESTRATOR_URL=http://localhost:8001

# ── STT providers (at least one required) ────────────────────
DEEPGRAM_API_KEY=your-deepgram-key

# ── LLM providers (at least one required) ────────────────────
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=your-google-key           # for Gemini
# GROQ_API_KEY=your-groq-key
# MISTRAL_API_KEY=your-mistral-key
# DEEPSEEK_API_KEY=your-deepseek-key
# ANTHROPIC_API_KEY=sk-ant-...             # for Claude

# ── TTS providers (at least one required) ────────────────────
# SARVAM_API_KEY=your-sarvam-key           # Sarvam AI (India)
# ELEVENLABS_API_KEY=your-elevenlabs-key
# CARTESIA_API_KEY=your-cartesia-key
# (OpenAI TTS uses OPENAI_API_KEY above)
# (Google WaveNet uses GOOGLE_API_KEY above)

# ── Custom LLM endpoint (optional) ───────────────────────────
# CUSTOM_LLM_API_KEY=your-key
